programa {
  funcao inicio() {
    // dados e variáveis
    inteiro qtd_estagiarios, qtd_clt, qtd_pj
    inteiro equipe
    // ler os dados
    escreva("Digite o número de estagiários: ")
    leia(qtd_estagiarios)
    escreva("Digite o número de CLTs: ")
    leia(qtd_clt)
    escreva("Digite o número de PJs: ")
    leia(qtd_pj)
    // processar/calcular
    equipe = qtd_estagiarios + qtd_clt + qtd_pj
    // apresentar os resultados   
    escreva("A equipe tem " + equipe + " devs") 
  }
}

// - {🦾} Guilherme Portões e a força de trabalho da Macrohard
// Guilherme Portões solicitou ao RH da sua empresa números sobre quantos devs CLT, quantos estagiários e quantos devs PJ a empresa tem no momento.
    
// Crie um programa com as variáveis clt, estagiarios e pj, que calcule e mostre o total de devs que a empresa tem na equipe.
    
