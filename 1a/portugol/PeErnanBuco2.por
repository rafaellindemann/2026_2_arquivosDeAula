programa {
  funcao inicio() {
    // dados e variáveis
    real custos, recebidos, faltante
    // leitura dos dados
    escreva("Custos da igreja: R$")
    leia(custos)
    escreva("Valores que a igreja recebeu: R$")
    leia(recebidos)
    // processamento
    faltante = custos - recebidos
    // mostrar resultados
    escreva("Falta arrecadar R$" + faltante)    
  }
}


