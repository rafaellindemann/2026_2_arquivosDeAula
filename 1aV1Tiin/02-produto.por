programa {
  funcao inicio() {
    real valor = 1234.56
    cadeia nome = "Fantasia de PC gamer"
    inteiro quantidade = 10
    real valorEmEstoque = valor * quantidade
    escreva("Produto: " + nome)
    escreva("\nValor: R$" + valor)
    escreva("\nQtd em estoque: " + quantidade + " unidades")
    escreva("\nValor em estoque: R$" + valorEmEstoque)
  }
}
